        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nlet out = { action: 'ignore', chatId: '', topic: '', query: '', callbackQueryId: '' };\nif (j.callback_query) {\n  out.chatId = j.callback_query.message && j.callback_query.message.chat ? j.callback_query.message.chat.id : '';\n  out.callbackQueryId = j.callback_query.id || '';\n  const data = j.callback_query.data || '';\n  if (data === 'CUSTOM') { out.action = 'prompt_custom'; }\n  else {\n  out.action = 'generate';\n  out.topic = data;\n}\n} else if (j.message && j.message.text) {\n  out.chatId = j.message.chat ? j.message.chat.id : '';\n  const text = j.message.text.trim();\n  if (text.toLowerCase().indexOf('/post ') === 0) { out.action = 'generate'; out.topic = text.slice(6).trim(); }\n  else if (text.toLowerCase() === '/start') { out.action = 'search'; out.query = 'latest AI ML news trends'; }\n  else { out.action = 'search'; out.query = text; }\n}\nreturn { json: out };"
      },
