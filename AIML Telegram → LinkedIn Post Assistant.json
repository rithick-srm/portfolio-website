    {
      "parameters": {
        "jsCode": "let text = $json.content.parts[0].text;\n\n// Keep only short lines\nconst topics = text\n  .split(\"\\n\")\n  .map(t => t.trim())\n  .filter(\n    t =>\n      t.length > 0 &&\n      t.length < 50 &&\n      !t.includes(\":\") &&\n      !t.startsWith(\"*\")\n  )\n  .slice(0, 3);\n\nreturn [\n  {\n    json: {\n      topics\n    }\n  }\n];"
      },
