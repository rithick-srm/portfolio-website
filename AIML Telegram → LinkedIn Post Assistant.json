        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json;\nfunction extractText(o){\n  if(!o) return '';\n  if(typeof o === 'string') return o;\n  if(o.content && o.content.parts && o.content.parts[0] && o.content.parts[0].text) return o.content.parts[0].text;\n  if(typeof o.content === 'string') return o.content;\n  if(o.text) return o.text;\n  if(o.message && o.message.content) return o.message.content;\n  return '';\n}\nconst postText = extractText(raw).trim();\nconst chatId = $('Parse Update').item.json.chatId;\nreturn { json: { postText: postText, chatId: chatId } };"
      },
